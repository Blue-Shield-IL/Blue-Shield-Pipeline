# Elasticsearch (VPN required for team server)
ELASTIC_HOST=https://10.10.248.126:9200
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=
ELASTIC_POSTS_INDEX=posts
ELASTIC_VERIFY_CERTS=false
ELASTIC_CA_CERTS=
ELASTIC_REQUEST_TIMEOUT=30
ELASTIC_EMBEDDING_DIMS=384

# ML Models
FILTER_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
FILTER_TARGET_LABEL=NEGATIVE
SENTENCE_MODEL_NAME=all-MiniLM-L6-v2
SENTIMENT_MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment
ZERO_SHOT_MODEL_NAME=facebook/bart-large-mnli
NER_MODEL_NAME=dbmdz/bert-large-cased-finetuned-conll03-english
