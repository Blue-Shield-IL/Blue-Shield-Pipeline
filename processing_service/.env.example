# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# These variables are consumed by processing_service/config.py.

# Full URL (scheme + host + port) of the Elasticsearch node.
# The team-hosted instance is reachable via VPN at:
ELASTIC_HOST=https://10.10.248.126:9200

# Credentials for the default `elastic` superuser.
# Rotate via the server owner — do NOT commit real values.
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=replace-me

# Index used for processed posts.
ELASTIC_POSTS_INDEX=posts

# TLS verification. The dev server uses a self-signed CA; set to false
# for local work, or provide ELASTIC_CA_CERTS pointing at the CA bundle.
ELASTIC_VERIFY_CERTS=false
# ELASTIC_CA_CERTS=/absolute/path/to/http_ca.crt

# Client request timeout in seconds.
ELASTIC_REQUEST_TIMEOUT=30
